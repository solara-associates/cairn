# Copy to terraform.tfvars and fill in real values. Never commit terraform.tfvars
# itself — it is already covered by the repo-wide CI secret scan (ADR-001), but
# none of these values are secrets; they are identifiers Allan provides.

project_id          = "cairn-dev-REPLACE_ME"
billing_account_id  = "REPLACE_ME" # format: XXXXXX-XXXXXX-XXXXXX
notification_email  = "REPLACE_ME@solara.associates"

# region, workload_image, evidence_retention_period_seconds and
# monthly_budget_amount_units all have workable dev defaults in variables.tf.
